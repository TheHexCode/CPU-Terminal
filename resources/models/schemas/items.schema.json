{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ItemSchema",
    "type": "object",
    "properties":
    {
        "items":
        {
            "type": "array",
            "items":
            {
                "type": "object",
                "properties":
                {
                    "name":
                    {
                        "type": "string",
                        "pattern": "^[^']+$"
                    },
                    "flavor": { "type": "string" },
                    "owner": { "type": "string" },
                    "instance":
                    {
                        "type": "array",
                        "items":
                        {
                            "type": "object",
                            "properties":
                            {
                                "name": { "type": "string" },
                                "displayName": { "type": "string" },
                                "options":
                                {
                                    "type": "object",
                                    "properties":
                                    {
                                        "path":
                                        {
                                            "type": "string",
                                            "pattern": "^(db):.+$"
                                        },
                                        "value": { "type": "string" },
                                        "label": { "type": "string" }
                                    },
                                    "required":
                                    [
                                        "path",
                                        "value",
                                        "label"
                                    ]
                                }
                            },
                            "required":
                            [
                                "name",
                                "displayName",
                                "options"
                            ]
                        }
                    },
                    "tags":
                    {
                        "type": "array",
                        "items":
                        {
                            "type": "object",
                            "properties":
                            {
                                "tag":
                                {
                                    "type": "string",
                                    "enum":
                                    [
                                        "multiple",
                                        "unique",
                                        "hacking_script",
                                        "charges",
                                        "limited",
                                        "exhausting"
                                    ]
                                }
                            },
                            "allOf":
                            [
                                {
                                    "if":
                                    {
                                        "properties":
                                        {
                                            "tag": { "const": "hacking_script" }
                                        },
                                        "required": [ "tag" ]
                                    },
                                    "then":
                                    {
                                        "properties":
                                        {
                                            "value": { "type": "number" }
                                        },
                                        "required": [ "value" ]
                                    }
                                },
                                {
                                    "if":
                                    {
                                        "properties":
                                        {
                                            "tag": { "const": "charges" }
                                        },
                                        "required": [ "tag" ]
                                    },
                                    "then":
                                    {
                                        "properties":
                                        {
                                            "value": { "type": "string" }
                                        },
                                        "required": [ "value" ]
                                    }
                                }
                            ]
                        }
                    },
                    "tiers":
                    {
                        "type": "array",
                        "items":
                        {
                            "type": "object",
                            "properties":
                            {
                                "tier": { "type": "number"},
                                "tierName": { "type": "string" },
                                "benefits":
                                {
                                    "type": "array",
                                    "items":
                                    {
                                        "type": "object",
                                        "properties":
                                        {
                                            "name": { "type": "string" },
                                            "values":
                                            {
                                                "type": "array",
                                                "items":
                                                {
                                                    "type": "object",
                                                    "properties":
                                                    {
                                                        "name": { "type": "string"},
                                                        "amount": { "type": "number" },
                                                        "source":
                                                        {
                                                            "type": "string",
                                                            "pattern": "^/resources/images/.+\\.png$"
                                                        }
                                                    },
                                                    "required": [ "name" ]
                                                }
                                            },
                                            "charges": { "type": "number" },
                                            "perType":
                                            {
                                                "enum":
                                                [
                                                    "sim",
                                                    "scene",
                                                    "term",
                                                    "item"
                                                ]
                                            }
                                        },
                                        "required": [ "name" ],
                                        "dependentRequired":
                                        {
                                            "charges": [ "perType" ],
                                            "perType": [ "charges" ]
                                        }
                                    }
                                }
                            },
                            "required":
                            [
                                "tier",
                                "benefits"
                            ]
                        }
                    }
                },
                "anyOf":
                [
                    {
                        "properties":
                        {
                            "category": { "const": "arms" },
                            "subCategory":
                            {
                                "enum":
                                [
                                    "ranged_1h",
                                    "ranged_2h",
                                    "melee_1h",
                                    "melee_2h",
                                    "shield_small",
                                    "shield_large",
                                    "armor"
                                ]
                            }
                        }
                    },
                    {
                        "properties":
                        {
                            "category": { "const": "customization" },
                            "subCategory":
                            {
                                "enum":
                                [
                                    "cyberdeck_software",
                                    "cyberdeck",
                                    "asw_body"
                                ]
                            }
                        }
                    },
                    {
                        "properties":
                        {
                            "category": { "const": "utility" },
                            "subCategory":
                            {
                                "enum":
                                [
                                    "utility",
                                    "cyberdeck",
                                    "hacking_watch",
                                    "modscript",
                                    "implant_arm",
                                    "consumable",
                                    "consumable_drug"
                                ]
                            }
                        }
                    },
                    {
                        "properties":
                        {
                            "category": { "const": "resource" },
                            "subCategory":
                            {
                                "enum":
                                [
                                    "secret"
                                ]
                            }
                        }
                    }
                ],
                "required":
                [
                    "name",
                    "category",
                    "subCategory",
                    "tags",
                    "tiers"
                ]
            }
        }
    }
}